# 本番/検証サーバー用の設定例。コピーして .env.prod を作り、実際の値を設定する(.env.prod は Git 管理しない)。
# 値はダミー。ここに本物のパスワードを書かないこと。

# 公開ホスト名(HTTPS証明書はCaddyが自動取得する)
SITE_ADDRESS=training.example.com

# GHCRのオーナー(小文字)とデプロイするバージョンタグ
GHCR_OWNER=your-github-owner
APP_VERSION=v0.1.0

MYSQL_DATABASE=trainingapp
MYSQL_USER=trainingapp
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# 初回起動(usersテーブルが空)のときだけAdminを作成する。作成後は両方を削除する。
TRAININGAPP_ADMIN_USERNAME=
TRAININGAPP_ADMIN_PASSWORD=
